<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment.TripEstimateFragment">

    <!-- Header Layout -->
    <LinearLayout
        android:id="@+id/linearLayout5"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/backIv"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_gravity="center"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="15dp"
            android:padding="3dp"
            android:src="@drawable/arrow_left" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout5">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp">

            <!-- Icon and Title Section -->
            <LinearLayout
                android:id="@+id/linearLayout6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginVertical="10dp"
                    app:cardCornerRadius="10dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imageView"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:background="@drawable/four_lines"
                            android:backgroundTint="?attr/colorSurface"
                            android:translationX="-10dp"
                            android:visibility="gone"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/itemImage"
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:layout_margin="15dp"
                            android:src="@drawable/speed"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/itemName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginVertical="20dp"
                    android:gravity="center"
                    android:text="Trip Estimate"
                    android:textSize="23sp" />

            </LinearLayout>

            <!-- Input and Results Section -->
            <LinearLayout
                android:id="@+id/linearLayout4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/linearLayout6">

                <!-- Input Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/tripInputCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:text="Trip Details"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <!-- Distance Input -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:padding="8dp"
                                android:text="Destination"
                                android:textSize="16sp" />

                            <EditText
                                android:id="@+id/etDestination"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="Where are you going?"
                                android:inputType="textCapWords"
                                android:maxLength="50"
                                android:padding="12dp"
                                android:textSize="16sp" />

                        </LinearLayout>

                        <!-- Distance Input -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:padding="8dp"
                                android:text="Distance (km)"
                                android:textSize="16sp" />

                            <EditText
                                android:id="@+id/etDistance"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="Enter distance"
                                android:inputType="numberDecimal"
                                android:maxLength="6"
                                android:padding="12dp"
                                android:textSize="16sp" />

                        </LinearLayout>

                        <!-- Days Input -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:padding="8dp"
                                android:text="Days"
                                android:textSize="16sp" />

                            <EditText
                                android:id="@+id/etDays"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="Number of days"
                                android:inputType="number"
                                android:maxLength="3"
                                android:padding="12dp"
                                android:text="1"
                                android:textSize="16sp" />

                        </LinearLayout>

                        <!-- Vehicle Type Spinner -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:padding="8dp"
                                android:text="Vehicle Type"
                                android:textSize="16sp" />

                            <Spinner
                                android:id="@+id/spinnerVehicleType"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:padding="12dp" />

                        </LinearLayout>

                        <!-- Mileage Input -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:padding="8dp"
                                android:text="Mileage (km/L)"
                                android:textSize="16sp" />

                            <EditText
                                android:id="@+id/etMileage"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="Fuel efficiency"
                                android:inputType="numberDecimal"
                                android:maxLength="5"
                                android:padding="12dp"
                                android:textSize="16sp" />

                        </LinearLayout>

                        <!-- Fuel Price Input -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:padding="8dp"
                                android:text="Fuel Price/L"
                                android:textSize="16sp" />

                            <EditText
                                android:id="@+id/etFuelPrice"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="Price per liter"
                                android:inputType="numberDecimal"
                                android:maxLength="6"
                                android:padding="12dp"
                                android:textSize="16sp" />

                        </LinearLayout>

                        <!-- Currency Spinner -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:padding="8dp"
                                android:text="Currency"
                                android:textSize="16sp" />

                            <Spinner
                                android:id="@+id/spinnerCurrency"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:padding="12dp" />

                        </LinearLayout>

                        <!-- Accommodation Section -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="8dp"
                            android:background="?attr/colorSurface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="Accommodation &amp; Expenses"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <!-- Accommodation Type Spinner -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:padding="8dp"
                                android:text="Accommodation"
                                android:textSize="16sp" />

                            <Spinner
                                android:id="@+id/spinnerAccommodationType"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:padding="12dp" />

                        </LinearLayout>

                        <!-- Accommodation Cost Input -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:padding="8dp"
                                android:text="Cost/Night"
                                android:textSize="16sp" />

                            <EditText
                                android:id="@+id/etAccommodationCost"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="Per night cost"
                                android:inputType="numberDecimal"
                                android:maxLength="6"
                                android:padding="12dp"
                                android:textSize="16sp" />

                        </LinearLayout>

                        <!-- Food Cost Input -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:padding="8dp"
                                android:text="Food/Day"
                                android:textSize="16sp" />

                            <EditText
                                android:id="@+id/etFoodCost"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="Daily food cost"
                                android:inputType="numberDecimal"
                                android:maxLength="6"
                                android:padding="12dp"
                                android:text="30"
                                android:textSize="16sp" />

                        </LinearLayout>

                        <!-- Miscellaneous Cost Input -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:padding="8dp"
                                android:text="Misc/Day"
                                android:textSize="16sp" />

                            <EditText
                                android:id="@+id/etMiscCost"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="Daily misc expenses"
                                android:inputType="numberDecimal"
                                android:maxLength="6"
                                android:padding="12dp"
                                android:text="20"
                                android:textSize="16sp" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Share Button -->
                <Button
                    android:id="@+id/shareBt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginHorizontal="16dp"
                    android:drawableEnd="@drawable/share"
                    android:text="Share"
                    android:textAllCaps="false"
                    android:textColor="?android:attr/textColorPrimary" />

                <!-- Results Section -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/tripResultCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="16dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <!-- Main Result Section -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <!-- Total Cost Display -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Total Cost"
                                        android:textSize="36sp" />

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@+id/tvCurrencySymbol"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="$"
                                            android:textColor="?attr/colorPrimary"
                                            android:textSize="36sp" />

                                        <TextView
                                            android:id="@+id/tvTotalCost"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="0"
                                            android:textColor="?attr/colorPrimary"
                                            android:textSize="48sp" />

                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@+id/tvFuelNeeded"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="0 L"
                                            android:textSize="14sp" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text=" | "
                                            android:textSize="14sp" />

                                        <TextView
                                            android:id="@+id/tvTotalDistance"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="0 km"
                                            android:textSize="14sp" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text=" | "
                                            android:textSize="14sp" />

                                        <TextView
                                            android:id="@+id/tvNightsNeeded"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Day trip"
                                            android:textSize="14sp" />

                                    </LinearLayout>

                                </LinearLayout>

                                <!-- Divider -->
                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="match_parent"
                                    android:background="?attr/colorSurface" />

                                <!-- Per Person/Day Info -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:paddingStart="16dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:text="Per Person"
                                        android:textColor="?attr/colorPrimary"
                                        android:textSize="16sp" />

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_marginTop="10dp"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@+id/tvCurrencySymbol2"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="$"
                                            android:textSize="20sp" />

                                        <TextView
                                            android:id="@+id/tvCostPerPerson"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="0"
                                            android:textSize="24sp" />

                                    </LinearLayout>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_marginTop="16dp"
                                        android:text="Per Day"
                                        android:textColor="?attr/colorPrimary"
                                        android:textSize="16sp" />

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_marginTop="5dp"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@+id/tvCurrencySymbol3"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="$"
                                            android:textSize="16sp" />

                                        <TextView
                                            android:id="@+id/tvCostPerDay"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="0"
                                            android:textSize="18sp" />

                                    </LinearLayout>

                                </LinearLayout>

                            </LinearLayout>

                            <!-- Divider -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="16dp"
                                android:layout_marginBottom="16dp"
                                android:background="?attr/colorSurface" />

                            <!-- Cost Breakdown Section -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="Cost Breakdown"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="18sp" />

                            <GridLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:columnCount="2"
                                android:rowCount="2">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:gravity="center"
                                    android:text="Fuel"
                                    android:textSize="14sp" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:gravity="center"
                                    android:text="Accommodation"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/tvFuelCost"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:gravity="center"
                                    android:text="0"
                                    android:textSize="24sp" />

                                <TextView
                                    android:id="@+id/tvAccommodationTotal"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:gravity="center"
                                    android:text="0"
                                    android:textSize="24sp" />

                            </GridLayout>

                            <GridLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:columnCount="2"
                                android:rowCount="2">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:gravity="center"
                                    android:text="Food"
                                    android:textSize="14sp" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:gravity="center"
                                    android:text="Miscellaneous"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/tvFoodTotal"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:gravity="center"
                                    android:text="0"
                                    android:textSize="24sp" />

                                <TextView
                                    android:id="@+id/tvMiscTotal"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:gravity="center"
                                    android:text="0"
                                    android:textSize="24sp" />

                            </GridLayout>

                            <!-- Trip Details ScrollView -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="16dp"
                                android:layout_marginBottom="16dp"
                                android:background="?attr/colorSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="Trip Details"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="18sp" />

                            <ScrollView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:maxHeight="300dp">

                                <TextView
                                    android:id="@+id/tvTripDetails"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:lineSpacingExtra="2dp"
                                    android:padding="8dp"
                                    android:text="Enter trip details above to see calculation"
                                    android:textSize="12sp" />

                            </ScrollView>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="16dp"
                                android:text="@string/powered_by"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="10sp" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>