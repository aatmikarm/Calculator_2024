<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/btHistory"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:gravity="top"
            android:orientation="vertical"
            android:padding="8dp"
            ads:layout_constraintBottom_toTopOf="@+id/linearLayout2"
            ads:layout_constraintEnd_toEndOf="parent"
            ads:layout_constraintStart_toStartOf="parent"
            ads:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <androidx.cardview.widget.CardView
                    android:id="@+id/memoryIndicator"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:elevation="10dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/memory_indicator_color"
                    android:visibility="gone"
                    ads:cardCornerRadius="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="M"
                        android:textColor="?attr/colorOnPrimary"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:elevation="10dp"
                    android:backgroundTint="?attr/colorPrimary"
                    ads:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/historyArrow"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/file_search"
                            android:backgroundTint="?attr/colorOnPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Calculation History"
                            android:textSize="14sp"
                            android:textColor="?attr/colorOnPrimary"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_marginHorizontal="10dp" />

                    </LinearLayout>



                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHistory"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

        </LinearLayout>

        <ScrollView
            android:id="@+id/linearLayout2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            ads:layout_constraintBottom_toTopOf="@+id/linearLayout"
            ads:layout_constraintEnd_toEndOf="parent"
            ads:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvErrorBC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-light"
                    android:gravity="end"
                    android:textSize="12sp"
                    android:textColor="@color/error_color"
                    android:visibility="gone"
                    tools:text="Invalid expression" />

                <TextView
                    android:id="@+id/tvSecondaryBC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-light"
                    android:gravity="end"
                    android:maxLines="2"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorSecondary"
                    tools:text="5+10-3" />

                <TextView
                    android:id="@+id/tvPrimaryBC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif"
                    android:gravity="end"
                    android:hint="0"
                    android:maxLines="2"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="42sp"
                    android:textStyle="bold"
                    tools:text="12" />

            </LinearLayout>

        </ScrollView>

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="8dp"
            ads:layout_constraintEnd_toEndOf="parent"
            ads:layout_constraintBottom_toTopOf="@id/ad_view_container"
            ads:layout_constraintStart_toStartOf="parent"
            tools:layout_editor_absoluteY="388dp">

            <!-- Advanced Scientific buttons panel -->
            <GridLayout
                android:id="@+id/advancedScientificPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:alignmentMode="alignBounds"
                android:columnCount="6"
                android:columnOrderPreserved="false"
                android:rowCount="1"
                android:useDefaultMargins="false"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btSinh"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_row="0"
                    android:layout_column="0"
                    android:layout_columnWeight="1"
                    android:layout_margin="1.5dp"
                    android:text="sinh"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btCosh"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_row="0"
                    android:layout_column="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="1.5dp"
                    android:text="cosh"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btTanh"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_row="0"
                    android:layout_column="2"
                    android:layout_columnWeight="1"
                    android:layout_margin="1.5dp"
                    android:text="tanh"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btLog2"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_row="0"
                    android:layout_column="3"
                    android:layout_columnWeight="1"
                    android:layout_margin="1.5dp"
                    android:text="log₂"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btE"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_row="0"
                    android:layout_column="4"
                    android:layout_columnWeight="1"
                    android:layout_margin="1.5dp"
                    android:text="e"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btScientificNotation"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_row="0"
                    android:layout_column="5"
                    android:layout_columnWeight="1"
                    android:layout_margin="1.5dp"
                    android:text="EXP"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

            </GridLayout>

            <!-- Scientific buttons panel -->
            <GridLayout
                android:id="@+id/scientificButtonsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:alignmentMode="alignBounds"
                android:columnCount="6"
                android:columnOrderPreserved="false"
                android:rowCount="2"
                android:useDefaultMargins="false"
                android:visibility="gone">

                <!-- First Row -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btSecond"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_row="0"
                    android:layout_column="0"
                    android:layout_columnWeight="1"
                    android:layout_margin="1.5dp"
                    android:text="2nd"
                    android:textAllCaps="false"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btDeg"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_row="0"
                    android:layout_column="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="1.5dp"
                    android:text="deg"
                    android:textAllCaps="false"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btSin"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_row="0"
                    android:layout_column="2"
                    android:layout_columnWeight="1"
                    android:layout_margin="1.5dp"
                    android:text="sin"
                    android:textAllCaps="false"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btCos"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_row="0"
                    android:layout_column="3"
                    android:layout_columnWeight="1"
                    android:layout_margin="1.5dp"
                    android:text="cos"
                    android:textAllCaps="false"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btTan"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_row="0"
                    android:layout_column="4"
                    android:layout_columnWeight="1"
                    android:layout_margin="1.5dp"
                    android:text="tan"
                    android:textAllCaps="false"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btRootX"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_row="0"
                    android:layout_column="5"
                    android:layout_columnWeight="1"
                    android:layout_margin="1.5dp"
                    android:text="√x"
                    android:textAllCaps="false"
                    android:textSize="14sp" />

                <!-- Second Row -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btPowerXY"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_row="1"
                    android:layout_column="0"
                    android:layout_columnWeight="1"
                    android:layout_margin="1.5dp"
                    android:text="x^y"
                    android:textAllCaps="false"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btLg"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_row="1"
                    android:layout_column="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="1.5dp"
                    android:text="lg"
                    android:textAllCaps="false"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btLn"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_row="1"
                    android:layout_column="2"
                    android:layout_columnWeight="1"
                    android:layout_margin="1.5dp"
                    android:text="ln"
                    android:textAllCaps="false"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btFactorial"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_row="1"
                    android:layout_column="3"
                    android:layout_columnWeight="1"
                    android:layout_margin="1.5dp"
                    android:text="x!"
                    android:textAllCaps="false"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btInverse"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_row="1"
                    android:layout_column="4"
                    android:layout_columnWeight="1"
                    android:layout_margin="1.5dp"
                    android:text="1/x"
                    android:textAllCaps="false"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btPi"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_row="1"
                    android:layout_column="5"
                    android:layout_columnWeight="1"
                    android:layout_margin="1.5dp"
                    android:text="π"
                    android:textAllCaps="false"
                    android:textSize="14sp" />

            </GridLayout>

            <!-- Memory and Control buttons -->
            <GridLayout
                android:id="@+id/memoryControlPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:alignmentMode="alignBounds"
                android:columnCount="6"
                android:columnOrderPreserved="false"
                android:rowCount="1"
                android:useDefaultMargins="false"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btMemoryClear"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_row="0"
                    android:layout_column="0"
                    android:layout_columnWeight="1"
                    android:layout_margin="1.5dp"
                    android:text="MC"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btMemoryRecall"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_row="0"
                    android:layout_column="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="1.5dp"
                    android:text="MR"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btMemoryAdd"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_row="0"
                    android:layout_column="2"
                    android:layout_columnWeight="1"
                    android:layout_margin="1.5dp"
                    android:text="M+"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btMemorySubtract"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_row="0"
                    android:layout_column="3"
                    android:layout_columnWeight="1"
                    android:layout_margin="1.5dp"
                    android:text="M-"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btUndo"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_row="0"
                    android:layout_column="4"
                    android:layout_columnWeight="1"
                    android:layout_margin="1.5dp"
                    android:text="⟲"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btRedo"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_row="0"
                    android:layout_column="5"
                    android:layout_columnWeight="1"
                    android:layout_margin="1.5dp"
                    android:text="⟳"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

            </GridLayout>

            <!-- Toggle Button -->
            <LinearLayout
                android:id="@+id/toggleBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:backgroundTint="?attr/colorPrimary"
                    ads:cardCornerRadius="12dp">

                    <ImageView
                        android:id="@+id/toggleArrow"
                        android:layout_width="10dp"
                        android:layout_height="5dp"
                        android:layout_gravity="center"
                        android:background="@drawable/arrow_up"
                        android:backgroundTint="?attr/colorOnPrimary" />

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Basic Calculator Buttons -->
            <GridLayout
                android:id="@+id/basicButtonsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alignmentMode="alignBounds"
                android:columnCount="4"
                android:columnOrderPreserved="false"
                android:rowCount="5"
                android:useDefaultMargins="false">

                <!-- Row 1: C ( ) ÷ -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btACBC"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_row="0"
                    android:layout_column="0"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:text="C"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btBracketOpenBC"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_row="0"
                    android:layout_column="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:text="("
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btBracketCloseBC"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_row="0"
                    android:layout_column="2"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:text=")"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btDivisionBC"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_row="0"
                    android:layout_column="3"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:text="÷"
                    android:textStyle="bold" />

                <!-- Row 2: 7 8 9 × -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/bt7BC"
                    style="@style/Light_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_row="1"
                    android:layout_column="0"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:text="7"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/bt8BC"
                    style="@style/Light_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_row="1"
                    android:layout_column="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:text="8"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/bt9BC"
                    style="@style/Light_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_row="1"
                    android:layout_column="2"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:text="9"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btMultiplicationBC"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_row="1"
                    android:layout_column="3"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:text="×"
                    android:textStyle="bold" />

                <!-- Row 3: 4 5 6 - -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/bt4BC"
                    style="@style/Light_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_row="2"
                    android:layout_column="0"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:text="4"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/bt5BC"
                    style="@style/Light_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_row="2"
                    android:layout_column="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:text="5"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/bt6BC"
                    style="@style/Light_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_row="2"
                    android:layout_column="2"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:text="6"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btSubtractionBC"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_row="2"
                    android:layout_column="3"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:text="-"
                    android:textScaleX="2"
                    android:textStyle="bold" />

                <!-- Row 4: 1 2 3 + -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/bt1BC"
                    style="@style/Light_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_row="3"
                    android:layout_column="0"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:text="1"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/bt2BC"
                    style="@style/Light_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_row="3"
                    android:layout_column="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:text="2"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/bt3BC"
                    style="@style/Light_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_row="3"
                    android:layout_column="2"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:text="3"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btAdditionBC"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_row="3"
                    android:layout_column="3"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:text="+"
                    android:textStyle="bold" />

                <!-- Row 5: ⌫ 0 . = -->
                <ImageView
                    android:id="@+id/btDeleteBC"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_row="4"
                    android:layout_column="0"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:padding="16dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/backspace" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/bt0BC"
                    style="@style/Light_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_row="4"
                    android:layout_column="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:text="0"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btDotBC"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_row="4"
                    android:layout_column="2"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:text="."
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btEqualBC"
                    style="@style/Dark_Button_Style"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_row="4"
                    android:layout_column="3"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/dark_btn_bg"
                    android:backgroundTint="?attr/colorPrimary"
                    android:elevation="2dp"
                    android:fontFamily="sans-serif"
                    android:foreground="@drawable/button_ripple"
                    android:text="="
                    android:textColor="?attr/colorOnPrimary"
                    android:textStyle="bold" />

            </GridLayout>

        </LinearLayout>

        <FrameLayout
            android:id="@+id/ad_view_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            ads:layout_constraintBottom_toBottomOf="parent"
            ads:layout_constraintEnd_toEndOf="parent"
            ads:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>