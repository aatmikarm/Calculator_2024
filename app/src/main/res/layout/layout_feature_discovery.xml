<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/featureDiscoveryRoot"
    android:clickable="true"
    android:focusable="true">

    <!-- Semi-transparent overlay -->
    <View
        android:id="@+id/overlayBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000" />

    <!-- Spotlight circle (this will be positioned dynamically) -->
    <View
        android:id="@+id/spotlightCircle"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/spotlight_circle"
        android:visibility="invisible" />

    <!-- Description Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/descriptionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="50dp"
        android:layout_marginBottom="100dp"
        android:layout_gravity="bottom"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:backgroundTint="?attr/colorSurface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Step indicator -->
            <TextView
                android:id="@+id/tvStepIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1/6"
                android:textSize="12sp"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Feature title -->
            <TextView
                android:id="@+id/tvFeatureTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calculator Input"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginBottom="8dp" />

            <!-- Feature description -->
            <TextView
                android:id="@+id/tvFeatureDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter your calculations here. Tap to edit, or use the buttons below."
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="16dp" />

            <!-- Buttons row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <!-- Skip button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSkip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Skip"
                    android:textAllCaps="false"
                    android:layout_marginEnd="10dp"
                    android:backgroundTint="?attr/colorPrimary"
                    android:textColor="?attr/colorOnPrimary" />

                <!-- Next button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAllCaps="false"
                    android:text="Next"
                    android:backgroundTint="?attr/colorPrimary"
                    android:textColor="?attr/colorOnPrimary" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>