    <!-- Purple Theme -->
    <style name="Theme.Calculator.Purple" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorPrimaryDark">@color/purple_primary_dark</item>
        <item name="colorAccent">@color/purple_accent</item>
        <item name="android:colorBackground">@color/purple_background</item>
