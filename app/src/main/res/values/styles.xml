<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Your existing button styles - keeping them as they are -->
    <style name="Dark_Button_Style" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:gravity">center</item>
        <item name="fontFamily">sans-serif-light</item>
        <item name="android:background">@drawable/dark_btn_bg</item>
        <item name="android:foreground">@drawable/button_ripple</item>
        <item name="android:elevation">3dp</item>
        <item name="android:layout_margin">6dp</item>
    </style>

    <style name="Light_Button_Style" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:gravity">center</item>
        <item name="fontFamily">sans-serif-light</item>
        <item name="android:background">@drawable/btn_bg</item>
        <item name="android:foreground">@drawable/button_ripple</item>
        <item name="android:elevation">3dp</item>
        <item name="android:layout_margin">6dp</item>
    </style>

    <style name="equal_Button_Style" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:gravity">center</item>
        <item name="fontFamily">sans-serif-light</item>
        <item name="android:background">@drawable/circle_button</item>
        <item name="android:foreground">@drawable/button_ripple</item>
        <item name="android:elevation">3dp</item>
        <item name="android:layout_margin">6dp</item>
    </style>

    <style name="CustomMaterialDatePicker" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="android:background">?attr/colorSurface</item>
        <item name="colorOnPrimary">?attr/colorPrimary</item>
    </style>

    <style name="fabBigInv">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="borderWidth">0dp</item>
        <item name="fabSize">mini</item>
        <item name="android:visibility">invisible</item>
        <item name="android:enabled">false</item>
    </style>

    <style name="line">
        <item name="android:layout_width">370dp</item>
        <item name="android:layout_height">0.5dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:background">?attr/colorPrimary</item>
    </style>

    <style name="fabBig">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="borderWidth">0dp</item>
        <item name="fabSize">mini</item>
    </style>

    <style name="tvStyle">
        <item name="android:gravity">center</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="fontFamily">sans-serif-light</item>
        <item name="android:textAlignment">center</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="fontStyle">
        <item name="fontFamily">sans-serif-light</item>
    </style>

    <style name="sp">
        <item name="android:layout_width">120dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="backgroundTint">@color/gray</item>
        <item name="android:clickable">false</item>
        <item name="android:visibility">invisible</item>
    </style>

    <style name="btRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="btOpBig">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?android:selectableItemBackground</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>

    <style name="btNumBig">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?android:selectableItemBackground</item>
        <item name="android:textSize">42sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">sans-serif-light</item>
    </style>

    <!-- MAIN THEME DEFINITIONS - Updated for proper dark mode support -->

    <!-- Light and Dark Base Themes -->
    <style name="Theme.Calculator.Light" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">#E64A19</item>
        <item name="colorAccent">@color/colorPrimary</item>
        <item name="android:colorBackground">@color/gray_light</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/gray_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/gray_light</item>
    </style>

    <style name="Theme.Calculator.Dark" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">#E64A19</item>
        <item name="colorAccent">@color/colorPrimary</item>
        <item name="android:colorBackground">#121212</item>
        <item name="colorSurface">#1E1E1E</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#BBBBBB</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">#121212</item>
    </style>

    <!-- Default Calculator Theme (your current orange theme) -->
    <style name="Theme.Calculator" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">#E64A19</item>
        <item name="colorAccent">@color/colorPrimary</item>
        <item name="android:colorBackground">@color/gray_light</item>
